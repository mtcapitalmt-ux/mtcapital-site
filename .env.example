# URL pública do site, usada para metadados (Open Graph, sitemap, etc.).
# Obrigatória.
NEXT_PUBLIC_SITE_URL=https://mtcapital.com.br

# Entrega do lead (formulário do Guia): configure ao menos um dos dois
# destinos abaixo (e-mail via Resend e/ou webhook). Sem nenhum configurado,
# a rota /api/lead responde 500 orientando o visitante a falar no WhatsApp.

# E-mail via Resend (https://resend.com) — exige as DUAS variáveis abaixo.
RESEND_API_KEY=re_00000000_exemplo_nao_e_uma_chave_real
LEAD_EMAIL_DESTINO=contato@mtcapital.com.br

# Webhook alternativo/adicional (ex.: CRM, Zapier, n8n).
LEAD_WEBHOOK_URL=https://exemplo.com/webhook/lead
